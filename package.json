{
  "name": "@wbc-ui/code",
  "version": "3.0.0-rc.3",
  "description": "Vue 3 code editor and syntax highlighting component package for WBC-UI",
  "license": "MIT",
  "author": "Wissem Boughamoura",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbc-ui/code.git"
  },
  "homepage": "https://github.com/wbc-ui/code#readme",
  "bugs": {
    "url": "https://github.com/wbc-ui/code/issues"
  },
  "scripts": {
    "build": "vite build",
    "check:dist": "node tools/check_dist_freshness.mjs",
    "prepublishOnly": "npm run check:dist",
    "clean": "rm -rf dist",
    "clean:embed": "rm -rf dist-embed",
    "serve_vite": "vite --config vite.config.dev.js",
    "build:full-embed": "vite build --config vite.config.embed.js",
    "test": "vitest run",
    "release": "node ../../../tools/pkg_cli/publish_lib.js"
  },
  "dependencies": {
    "html2pdf.js": "^0.12.1"
  },
  "peerDependencies": {
    "@wbc-ui/core": "^3.0.0-rc.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "prismjs": "^1.30.0",
    "vite": "^6.4.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vuetify": "^3.7.0"
  }
}
